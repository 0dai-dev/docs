{
  "mcpServers": {
    "0dai": {
      "command": "python3",
      "args": ["scripts/mcp_server.py", "--target", "."],
      "env": {}
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y", "@anthropic-ai/mcp-server-filesystem",
        "/home/user/0dai"
      ]
    }
  }
}
